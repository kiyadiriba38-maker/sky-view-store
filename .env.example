# Sky View Store — environment template
# Copy these values into your local .env.local or the Render service environment.
# Never commit real credentials.

# Public storefront
NEXT_PUBLIC_SITE_NAME=Sky View Store
NEXT_PUBLIC_BASE_URL=https://sky-view-store-preview.onrender.com
NEXT_PUBLIC_SERVER_URL=https://sky-view-store-preview.onrender.com
# Supported storefront languages: en | am | om
NEXT_PUBLIC_LANG=en

# Required application secrets
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
PAYLOAD_SECRET=replace-with-a-long-random-secret
PREVIEW_SECRET=replace-with-a-different-long-random-secret

# Google Identity Services (optional until Google sign-in is enabled)
# Set both to the same Web OAuth client ID. The public value is not a secret.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Seller/listing moderation
# Leave empty until a responsible adult store administrator is designated.
# The matching administrator account is the only account allowed to publish
# third-party seller listings after policy review.
LISTING_MODERATOR_EMAIL=

# Media storage (optional for development; configure durable object storage
# before accepting production uploads on an ephemeral host such as Render).
# Supported providers: vercel | s3
STORAGE_PROVIDER=
NEXT_PUBLIC_STORAGE_URL=
BUCKET_PREFIX=sky-view-store
BLOB_TOKEN=
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email delivery (optional; when disabled, Payload logs email to service logs)
SEND_EMAIL_WHATSAPP=false
EMAIL_FROM_ADDRESS=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=

# Payments intentionally remain simulated. Do not enable Stripe or add live
# payment credentials unless the store owner separately approves a provider.
NEXT_PUBLIC_ENABLE_STRIPE=false
